{
	"name": "blobstoragesource",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureBlobStorage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"SourceContainer": {
				"type": "string"
			},
			"SourceFolder": {
				"type": "string"
			},
			"SourceFile": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@dataset().SourceFile",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().SourceFolder",
					"type": "Expression"
				},
				"container": {
					"value": "@dataset().SourceContainer",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"escapeChar": "\"",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}