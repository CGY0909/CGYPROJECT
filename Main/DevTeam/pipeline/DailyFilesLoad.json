{
	"name": "DailyFilesLoad",
	"properties": {
		"activities": [
			{
				"name": "Look_FilesareThereOrNot",
				"description": "Look_FilesareThereOrNot",
				"type": "Lookup",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": []
			},
			{
				"name": "GetFileMetaData",
				"description": "GetFileMetaData",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "BlobFileDataset",
						"type": "DatasetReference",
						"parameters": {
							"Container": {
								"value": "@pipeline().parameters.BlobContainerName",
								"type": "Expression"
							},
							"Folder": {
								"value": "@pipeline().parameters.BlobFolder",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			}
		],
		"parameters": {
			"SSMSServerName": {
				"type": "string"
			},
			"SSMSUserName": {
				"type": "string"
			},
			"SSMSDatabase": {
				"type": "string"
			},
			"SSMSPassword": {
				"type": "string"
			},
			"BlobContainerName": {
				"type": "string",
				"defaultValue": "input"
			},
			"BlobFolder": {
				"type": "string",
				"defaultValue": "Source"
			},
			"BlobFileNames": {
				"type": "array"
			},
			"TableSchemaName": {
				"type": "string"
			}
		},
		"annotations": []
	}
}