{
	"name": "DailyLoad",
	"properties": {
		"activities": [
			{
				"name": "Get Source FileNames",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "GetMetaDataDataSet",
						"type": "DatasetReference",
						"parameters": {
							"ContainerName": {
								"value": "@pipeline().parameters.SourceContainer",
								"type": "Expression"
							},
							"Folder": {
								"value": "@pipeline().parameters.SourceFolder",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Save SoureFileNames Variable",
				"description": "Save SoureFileNames Variable",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get Source FileNames",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "SourceFileNamesVariable",
					"value": {
						"value": "@activity('Get Source FileNames').output.childItems",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Load Each File",
				"description": "Load Each File",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Save SoureFileNames Variable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Source FileNames').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy data from source to sql",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "SqlServerSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"tableOption": "autoCreate"
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "blobstoragesource",
									"type": "DatasetReference",
									"parameters": {
										"SourceContainer": {
											"value": "@pipeline().parameters.SourceContainer",
											"type": "Expression"
										},
										"SourceFolder": {
											"value": "@pipeline().parameters.SourceFolder",
											"type": "Expression"
										},
										"SourceFile": {
											"value": "@item().itemName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "SqlServerDataset",
									"type": "DatasetReference",
									"parameters": {
										"SchemName": {
											"value": "@pipeline().parameters.SchemaName",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"SourceContainer": {
				"type": "string",
				"defaultValue": "input"
			},
			"SourceFolder": {
				"type": "string",
				"defaultValue": "Source"
			},
			"SourceFile": {
				"type": "array"
			},
			"TargetContainer": {
				"type": "string",
				"defaultValue": "output"
			},
			"TargetFolder": {
				"type": "string",
				"defaultValue": "Target"
			},
			"SchemaName": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"TableName": {
				"type": "string"
			}
		},
		"variables": {
			"SourceFileNamesVariable": {
				"type": "Array"
			}
		},
		"annotations": []
	}
}