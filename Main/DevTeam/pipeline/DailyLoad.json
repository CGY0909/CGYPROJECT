{
	"name": "DailyLoad",
	"properties": {
		"activities": [
			{
				"name": "Get Source FileNames",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "GetMetaDataDataSet",
						"type": "DatasetReference",
						"parameters": {
							"ContainerName": {
								"value": "@pipeline().parameters.SourceContainer",
								"type": "Expression"
							},
							"Folder": {
								"value": "@pipeline().parameters.SourceFolder",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Save SoureFileNames Variable",
				"description": "Save SoureFileNames Variable",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get Source FileNames",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "SourceFileNamesVariable",
					"value": {
						"value": "@activity('Get Source FileNames').output.itemName",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"SourceContainer": {
				"type": "string",
				"defaultValue": "input"
			},
			"SourceFolder": {
				"type": "string",
				"defaultValue": "Source"
			},
			"SourceFile": {
				"type": "array"
			},
			"TargetContainer": {
				"type": "string",
				"defaultValue": "output"
			},
			"TargetFolder": {
				"type": "string",
				"defaultValue": "Target"
			},
			"SchemaName": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"TableName": {
				"type": "string"
			}
		},
		"variables": {
			"SourceFileNamesVariable": {
				"type": "Array"
			}
		},
		"annotations": []
	}
}